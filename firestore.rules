rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Spots — readable by all, writable by any authenticated user
    match /spots/{spotId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }

    // Sessions — each user can only read/write their own
    match /sessions/{sessionId} {
      allow read, write: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }

    // User-submitted spots — anyone can submit, only admins verify
    match /user_spots/{spotId} {
      allow read: if resource.data.verified == true;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.submittedBy
        && request.resource.data.verified == false;
      allow update: if false; // admin only via Firebase console
    }

    // Crowd "spot taken" reports — public read, one doc per user/spot/hour
    match /occupancyReports/{reportId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
      allow delete: if false;
    }

    // Business parking records — public read, admin write only
    match /businessParking/{id} {
      allow read: if true;
      allow write: if false; // admin only via Firebase console
    }
  }
}
