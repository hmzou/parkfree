rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ── Spot occupancy helpers ───────────────────────────────────────────────
    // Keep MAX_HOLD_MINUTES in app/_services/occupancy.ts under this limit.

    function occupancyKeys() {
      return ['occupied', 'occupiedSince', 'occupiedBy', 'occupiedUntil'];
    }

    function spotKeys() {
      return ['source', 'lat', 'lng', 'type', 'feeRequired', 'timeRestrictions',
              'seasonalBan', 'city', 'verified', 'notes'].concat(occupancyKeys());
    }

    function holdExpired(data) {
      return data.get('occupiedUntil', null) == null
        || data.occupiedUntil < request.time;
    }

    // Someone else holds the spot and their hold has not run out yet.
    function heldByOther(data) {
      return data.get('occupied', false) == true
        && data.get('occupiedBy', null) != request.auth.uid
        && !holdExpired(data);
    }

    function validOccupancy(data) {
      return (
        data.occupied == true
        && data.occupiedBy == request.auth.uid
        && data.occupiedSince == request.time
        && data.occupiedUntil is timestamp
        && data.occupiedUntil > request.time
        && data.occupiedUntil <= request.time + duration.value(25, 'h')
      ) || (
        data.occupied == false
        && data.occupiedBy == null
        && data.occupiedSince == null
        && data.occupiedUntil == null
      );
    }

    // Spots — public read. Only the parked user can free a spot before its
    // hold expires, and nobody can take a spot someone else is holding.
    match /spots/{spotId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(spotKeys())
        && (!request.resource.data.keys().hasAny(occupancyKeys())
            || validOccupancy(request.resource.data));
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(spotKeys())
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(occupancyKeys())
            || (validOccupancy(request.resource.data) && !heldByOther(resource.data)));
      allow delete: if false;
    }

    // Sessions — each user can only read/write their own
    // Sessions double as a parking record for contesting tickets, so the
    // server sets the times and the position and record can't be edited later.
    // Ending a session may only set endTime (to the server's clock), active and hitLimit.
    match /sessions/{sessionId} {
      allow read, delete: if signedIn()
        && request.auth.uid == resource.data.userId;
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.startTime == request.time
        && request.resource.data.endTime == null;
      allow update: if signedIn()
        && request.auth.uid == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['endTime', 'active', 'hitLimit'])
        && (request.resource.data.endTime == null
            || request.resource.data.endTime == request.time);
    }

    // Per-user occupant markers behind the business occupancy meter. Each user
    // can only write their own doc, so lot counts cannot be forged.
    match /spotOccupants/{spotId}/users/{userId} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['startedAt', 'until'])
        && request.resource.data.startedAt == request.time
        && request.resource.data.until is timestamp
        && request.resource.data.until <= request.time + duration.value(25, 'h');
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    // User-submitted spots — anyone can submit, only admins verify
    match /user_spots/{spotId} {
      allow read: if resource.data.verified == true;
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.submittedBy
        && request.resource.data.verified == false
        && request.resource.data.lat is number
        && request.resource.data.lng is number;
      allow update: if false; // admin only via Firebase console
    }

    // Business parking records — public read, admin write only
    match /businessParking/{id} {
      allow read: if true;
      allow write: if false; // admin only via Firebase console
    }

    // "Wrong colour?" street corrections — write-only for drivers, reviewed
    // in the console before the dataset is rebuilt.
    match /mapCorrections/{id} {
      allow read, update, delete: if false;
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.shouldBe in ['free', 'noParking', 'paid']
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(['userId', 'kind', 'road', 'lat', 'lng', 'shouldBe', 'createdAt']);
    }

    // ── Ambassadors ──────────────────────────────────────────────────────────
    // Only real accounts (not anonymous users) can post sign photos, so every
    // report can be traced to a person and removed if it's wrong.
    function hasAccount() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Sign reports colour curbs on the map: public read, stamped with server
    // time, never edited (a newer photo replaces an older one on the map).
    match /signReports/{id} {
      allow read: if true;
      allow create: if hasAccount()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(['userId', 'lat', 'lng', 'accuracyMeters', 'headingDeg',
             'side', 'sideMethod', 'road', 'city', 'rule', 'hours', 'note', 'stretch', 'photoId', 'createdAt'])
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.side in ['left', 'right']
        && request.resource.data.rule in ['free', 'timeLimit', 'paid', 'permit', 'noParking', 'noStopping']
        && (request.resource.data.hours == null
            || (request.resource.data.hours is number && request.resource.data.hours > 0 && request.resource.data.hours <= 24))
        && request.resource.data.note is string && request.resource.data.note.size() <= 120
        && request.resource.data.stretch is list
        && request.resource.data.stretch.size() >= 2 && request.resource.data.stretch.size() <= 60
        && request.resource.data.photoId is string;
      allow update: if false;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // The sign photo itself: only the ambassador can read it (reviewers use
    // the console). Kept under 900 KB of base64 so it fits in one document.
    match /signPhotos/{id} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if hasAccount()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(['userId', 'image', 'createdAt'])
        && request.resource.data.image is string
        && request.resource.data.image.size() < 900000;
      allow update: if false;
    }

    // Crowd reports — public read so pin colors can update. One doc per
    // user per spot, stamped with server time, so reports cannot be stacked
    // or backdated to stay in the 2-hour window.
    match /occupancyReports/{reportId} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.auth.uid == request.resource.data.userId
        && reportId == request.auth.uid + '_' + request.resource.data.spotId
        && request.resource.data.reportedAt == request.time;
      allow delete: if false;
    }
  }
}
